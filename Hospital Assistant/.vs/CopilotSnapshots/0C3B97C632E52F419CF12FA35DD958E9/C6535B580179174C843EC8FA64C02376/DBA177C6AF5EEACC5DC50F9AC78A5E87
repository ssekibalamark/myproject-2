{% extends "app/layout.html" %}

{% block content %}

<div class="jumbotron">
    <div class="row">
        <div class="col-md-5 text-center">
            <svg viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg" style="width:100%; max-width:360px; height:auto;" role="img" aria-label="Illustration of a robot and a doctor caring for a patient together">
                <!-- Patient bed -->
                <rect x="90" y="230" width="220" height="16" rx="4" fill="#8c9aa6"/>
                <rect x="105" y="200" width="190" height="34" rx="6" fill="#e7ecef"/>
                <ellipse cx="150" cy="205" rx="26" ry="14" fill="#ffffff"/>
                <circle cx="150" cy="195" r="16" fill="#f2c9a0"/>
                <rect x="150" y="204" width="120" height="18" rx="6" fill="#4a90d9"/>

                <!-- Doctor -->
                <circle cx="80" cy="140" r="20" fill="#f2c9a0"/>
                <rect x="58" y="158" width="44" height="60" rx="10" fill="#ffffff" stroke="#c9d3d9" stroke-width="2"/>
                <rect x="58" y="158" width="44" height="60" rx="10" fill="none" stroke="#c9d3d9" stroke-width="2"/>
                <rect x="76" y="168" width="8" height="30" fill="#4a90d9"/>
                <circle cx="80" cy="132" r="6" fill="#5b3a29"/>

                <!-- Robot -->
                <rect x="300" y="150" width="56" height="66" rx="8" fill="#b9c2c9"/>
                <rect x="312" y="126" width="32" height="28" rx="6" fill="#d6dee3"/>
                <circle cx="322" cy="140" r="4" fill="#2e8b57"/>
                <circle cx="336" cy="140" r="4" fill="#2e8b57"/>
                <rect x="316" y="216" width="10" height="20" fill="#8c9aa6"/>
                <rect x="332" y="216" width="10" height="20" fill="#8c9aa6"/>
                <line x1="300" y1="170" x2="270" y2="200" stroke="#8c9aa6" stroke-width="6" stroke-linecap="round"/>
                <line x1="356" y1="170" x2="330" y2="150" stroke="#8c9aa6" stroke-width="6" stroke-linecap="round"/>
            </svg>
        </div>
        <div class="col-md-7">
            <h1>Hospital Assistant</h1>
            <p class="lead">
                A clinical support system where AI and healthcare professionals work side by side.
                Hospital Assistant helps doctors and specialists diagnose faster, suggest lab tests
                and medications, and manage patient records &mdash; with every AI recommendation
                reviewed and approved by a qualified specialist before it reaches the patient.
            </p>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <h2>AI-Assisted Diagnosis</h2>
        <p>
            Symptoms, lab results, and doctor's notes are analyzed to suggest possible diagnoses,
            required lab tests, and medications &mdash; always reviewed by a specialist first.
        </p>
    </div>
    <div class="col-md-4">
        <h2>Patient-Centered Records</h2>
        <p>
            Complete patient profiles including next of kin, encounters, and care history, kept
            securely in the hospital database.
        </p>
    </div>
    <div class="col-md-4">
        <h2>Role-Based Access</h2>
        <p>
            Staff registration is managed by the ICT department, with each medical role
            granted access only to the tools relevant to their work.
        </p>
    </div>
</div>

{% endblock %}
