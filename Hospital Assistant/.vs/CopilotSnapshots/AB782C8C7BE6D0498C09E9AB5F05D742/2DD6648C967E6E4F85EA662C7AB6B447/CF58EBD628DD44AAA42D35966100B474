{% extends "app/layout.html" %}

{% block content %}
<h2>Patients</h2>
<p>
    <a class="btn btn-success" href="{% url 'patient_create' %}">Register Patient</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Patient Number</th>
            <th>Name</th>
            <th>Date of Birth</th>
            <th>Sex</th>
            <th>Phone</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    {% for patient in patients %}
        <tr>
            <td>{{ patient.patient_number }}</td>
            <td>{{ patient.first_name }} {{ patient.last_name }}</td>
            <td>{{ patient.date_of_birth }}</td>
            <td>{{ patient.get_sex_display }}</td>
            <td>{{ patient.phone_number }}</td>
            <td>{{ patient.email }}</td>
            <td><a class="btn btn-primary btn-sm" href="{% url 'patient_update' patient.id %}">Edit</a></td>
        </tr>
    {% empty %}
        <tr>
            <td colspan="7">No patients found.</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
