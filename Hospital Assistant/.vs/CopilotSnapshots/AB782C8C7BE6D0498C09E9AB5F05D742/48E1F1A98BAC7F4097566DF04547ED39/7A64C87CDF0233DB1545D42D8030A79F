{% extends "app/layout.html" %}

{% block content %}
<h2>Staff Management</h2>
<p>
    <a class="btn btn-success" href="{% url 'staff_register' %}">Register Staff</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Staff ID</th>
            <th>User</th>
            <th>Role</th>
            <th>Department</th>
            <th>Phone</th>
            <th>License</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    {% for profile in staff_profiles %}
        <tr>
            <td>{{ profile.staff_id }}</td>
            <td>{{ profile.user }}</td>
            <td>{{ profile.get_role_display }}</td>
            <td>{{ profile.department }}</td>
            <td>{{ profile.phone_number }}</td>
            <td>{{ profile.license_number }}</td>
            <td>{% if profile.is_active %}Yes{% else %}No{% endif %}</td>
            <td><a class="btn btn-primary btn-sm" href="{% url 'staff_update' profile.id %}">Edit</a></td>
        </tr>
    {% empty %}
        <tr>
            <td colspan="8">No staff profiles found.</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
